{
    "ConnectionStrings": {
    "DefaultConnection": "Data Source=pagamentos.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
      }
    }
  },
  "Reservas": {
    "UrlBase": "http://localhost:5300",
    "TempoLimiteSegundos": 30
  },
  "AllowedHosts": "*"
}
